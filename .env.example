# Copia este fichero a .env y rellena el token. .env está en .gitignore.
#
#   cp .env.example .env
#
# El token se genera en https://www.npmjs.com/settings/<usuario>/tokens con
# permiso de publicación sobre el scope @vocea.app. Lo lee scripts/publish.sh,
# que lo inyecta en un .npmrc temporal; nunca se escribe dentro del repo.
NPM_AUTH_TOKEN=

# API key de Vocea para la suite e2e (pnpm test:e2e). Vacía = e2e omitidos.
# Usa una key de una cuenta de PRUEBAS, no la personal de producción.
VOCEA_API_KEY=
# Opcional: apunta los e2e a otro entorno. Por defecto https://vocea.app/api/v1
VOCEA_BASE_URL=
