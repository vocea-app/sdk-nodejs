{
  "name": "@vocea.app/sdk",
  "version": "0.1.0",
  "description": "Official Vocea SDK for Node.js/TypeScript",
  "author": "vocea.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/vocea-app/sdk-nodejs.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "vocea",
    "tts",
    "stt",
    "text-to-speech",
    "voice-cloning"
  ],
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
