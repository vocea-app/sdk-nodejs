# Configuración de publicación. Aquí NO va ningún token.
#
# El token vive en .env (ignorado por git) y lo inyecta scripts/publish.sh en un
# .npmrc temporal vía NPM_CONFIG_USERCONFIG. pnpm ignora deliberadamente las
# credenciales de registro que expanden variables de entorno desde un .npmrc de
# proyecto, porque este fichero se commitea. Ver `pnpm publish` en README.
registry=https://registry.npmjs.org/
access=public
